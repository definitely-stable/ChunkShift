<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageId>ChunkShift</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Content-aware binary chunking, manifests, verification and exact update primitives for .NET.</Description>
    <Authors>ChunkShift contributors</Authors>
    <PackageProjectUrl>https://github.com/definitely-stable/ChunkShift</PackageProjectUrl>
    <RepositoryUrl>https://github.com/definitely-stable/ChunkShift</RepositoryUrl>
    <PackageTags>chunking;binary-delta;content-addressing;patching;fastcdc</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChunkShift.Tests" />
    <PackageReference Include="Blake3" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>